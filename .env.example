API_KEYS=["your-secret-key-here"]
COOKIE_BROWSER=chrome
# Optional: path to a Netscape-format cookies.txt file (overrides browser extraction)
# COOKIE_FILE=/path/to/cookies.txt
DEFAULT_FORMAT=best
MAX_FILE_SIZE_MB=2048
TEMP_DIR=/tmp/media-downloader
HOST=0.0.0.0
PORT=8000
# Telegram sending (from the playground's "Send to Telegram" option)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
# Optional: local Telegram Bot API server to allow files larger than 50MB (up to ~2000MB)
# TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
# JSON list of allowed CORS origins for cross-origin browser calls (default: allow all)
# CORS_ORIGINS=["https://app.example.com"]